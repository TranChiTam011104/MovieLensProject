                  "pm.test('Response has similar_movies array', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('similar_movies');",
                  "    pm.expect(jsonData.similar_movies).to.be.an('array');",
                  "});",
